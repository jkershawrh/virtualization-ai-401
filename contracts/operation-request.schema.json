{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://demo-story.redhat-intel.com/virtualization-ai-401/operation-request.schema.json",
  "title": "Governed day-two operation request",
  "type": "object",
  "additionalProperties": false,
  "required": ["request_id", "operation", "target", "evidence_snapshot", "requested_by"],
  "properties": {
    "request_id": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{7,127}$"},
    "operation": {"enum": ["LIVE_MIGRATE", "VALIDATE_RECOVERY", "RESTORE_REVIEW"]},
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["namespace", "virtual_machine"],
      "properties": {
        "namespace": {"type": "string", "minLength": 1},
        "virtual_machine": {"type": "string", "minLength": 1}
      }
    },
    "evidence_snapshot": {"type": "string", "minLength": 8},
    "requested_by": {"type": "string", "minLength": 1},
    "approval": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["approved_by", "expires_at", "operation_digest"],
      "properties": {
        "approved_by": {"type": "string", "minLength": 1},
        "expires_at": {"type": "string", "format": "date-time"},
        "operation_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
      }
    }
  }
}

