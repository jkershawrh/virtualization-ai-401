{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://demo-story.redhat-intel.com/virtualization-ai-401/operation-response.schema.json",
  "title": "Governed day-two operation response",
  "type": "object",
  "additionalProperties": false,
  "required": ["request_id", "decision", "source_state", "policy", "authority", "evidence", "validation"],
  "properties": {
    "request_id": {"type": "string"},
    "decision": {"enum": ["ALLOW_REVIEW", "REFUSE", "ABSTAIN"]},
    "source_state": {"enum": ["LIVE", "REHEARSAL", "OFFLINE"]},
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "matched_rules"],
      "properties": {
        "id": {"const": "virtualization-ai-401-day-two"},
        "version": {"type": "string"},
        "matched_rules": {"type": "array", "items": {"type": "string"}, "minItems": 1}
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["human_review_required", "automated_action_performed", "llm_authority"],
      "properties": {
        "human_review_required": {"const": true},
        "automated_action_performed": {"const": false},
        "llm_authority": {"const": "NONE"}
      }
    },
    "evidence": {"type": "array", "items": {"$ref": "evidence-record.schema.json"}, "minItems": 1},
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "checks"],
      "properties": {
        "status": {"enum": ["NOT_RUN", "PASS", "FAIL", "INCOMPLETE"]},
        "checks": {"type": "array", "items": {"type": "string"}}
      }
    },
    "explanation": {"type": ["string", "null"]}
  }
}

