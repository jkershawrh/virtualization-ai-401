{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://virtualization-ai.redhat-intel.com/contracts/modernization-request-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "correlation_id", "task", "note", "allowed_categories", "declared", "observed"],
  "properties": {
    "schema_version": {"const": "virtualization-ai.redhat-intel.com/modernization-request/v1"},
    "correlation_id": {"type": "string", "format": "uuid"},
    "task": {"const": "review-vm-modernization"},
    "note": {"type": "string", "minLength": 1, "maxLength": 1000},
    "allowed_categories": {"type": "array", "items": {"enum": ["identity", "connectivity", "placement", "operations", "unknown"]}, "minItems": 5, "maxItems": 5, "uniqueItems": true},
    "declared": {"$ref": "#/$defs/declared"},
    "observed": {"$ref": "#/$defs/observed"}
  },
  "$defs": {
    "identity": {"type": "object", "additionalProperties": false, "required": ["namespace", "vm_name", "service_account"], "properties": {"namespace": {"type": "string", "minLength": 1}, "vm_name": {"type": "string", "minLength": 1}, "service_account": {"type": "string", "minLength": 1}, "vmi_uid": {"type": "string", "minLength": 1}}},
    "destination": {"type": "object", "additionalProperties": false, "required": ["service", "port"], "properties": {"service": {"type": "string", "minLength": 1}, "port": {"type": "integer", "minimum": 1, "maximum": 65535}, "network_policy": {"enum": ["ENFORCED", "NOT_ENFORCED", "UNKNOWN"]}, "endpoints_ready": {"type": "boolean"}}},
    "placement": {"type": "object", "additionalProperties": false, "required": ["architecture", "required_labels"], "properties": {"node_name": {"type": "string"}, "architecture": {"enum": ["amd64", "arm64", "unknown"]}, "required_labels": {"type": "object", "additionalProperties": {"type": "string"}}, "labels": {"type": "object", "additionalProperties": {"type": "string"}}}},
    "declared": {"type": "object", "additionalProperties": false, "required": ["identity", "destination", "placement"], "properties": {"identity": {"$ref": "#/$defs/identity"}, "destination": {"$ref": "#/$defs/destination"}, "placement": {"$ref": "#/$defs/placement"}}},
    "observability": {"type": "object", "additionalProperties": false, "required": ["correlation_id", "collected_at", "events_available"], "properties": {"correlation_id": {"type": "string", "format": "uuid"}, "collected_at": {"type": "string", "format": "date-time"}, "events_available": {"type": "boolean"}}},
    "observed": {"type": "object", "additionalProperties": false, "required": ["identity", "destination", "placement", "observability"], "properties": {"identity": {"$ref": "#/$defs/identity"}, "destination": {"$ref": "#/$defs/destination"}, "placement": {"$ref": "#/$defs/placement"}, "observability": {"$ref": "#/$defs/observability"}}}
  }
}
