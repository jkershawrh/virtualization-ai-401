{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://virtualization-ai.redhat-intel.com/contracts/modernization-response-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "correlation_id", "outcome", "source_state", "ai_participated", "reason_codes", "checks", "authority", "evidence_id"],
  "properties": {
    "schema_version": {"const": "virtualization-ai.redhat-intel.com/modernization-response/v1"},
    "correlation_id": {"type": "string", "format": "uuid"},
    "outcome": {"enum": ["ALLOW_REVIEW", "REFUSE", "ABSTAIN"]},
    "source_state": {"enum": ["LIVE", "REHEARSAL", "OFFLINE"]},
    "ai_participated": {"type": "boolean"},
    "reason_codes": {"type": "array", "items": {"enum": ["CONTROLS_COMPLETE", "IDENTITY_MISMATCH", "NETWORK_MISMATCH", "OBSERVABILITY_INCOMPLETE", "PLACEMENT_UNKNOWN", "PLACEMENT_MISMATCH", "MODEL_UNAVAILABLE"]}, "minItems": 1, "uniqueItems": true},
    "checks": {"type": "object", "additionalProperties": {"enum": ["PASS", "FAIL", "UNKNOWN", "NOT_RUN"]}},
    "advisory": {"type": "object", "additionalProperties": false, "required": ["category", "summary", "rationale"], "properties": {"category": {"enum": ["identity", "connectivity", "placement", "operations", "unknown"]}, "summary": {"type": "string", "minLength": 1}, "rationale": {"type": "string", "minLength": 1}}},
    "model": {"type": "object", "additionalProperties": false, "required": ["id", "provider", "hardware"], "properties": {"id": {"type": "string"}, "provider": {"type": "string"}, "hardware": {"type": "string"}}},
    "authority": {"const": "HUMAN_REVIEW_REQUIRED"},
    "evidence_id": {"type": "string", "format": "uuid"}
  }
}
